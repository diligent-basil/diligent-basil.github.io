<body>

    <h2>📋 Formularz Konfiguracji</h2>
    
    <div class="form-group">
        <label for="rest_name">Nazwa restauracji</label>
        <input type="text" id="rest_name" placeholder="Wpisz nazwę...">
    </div>

    <div class="form-group">
        <label for="client_id">ID Klienta (Konto)</label>
        <input type="text" id="client_id" placeholder="np. 123">
    </div>

    <div class="form-group">
        <label for="loc_id">ID Lokalizacji</label>
        <input type="text" id="loc_id" placeholder="np. 456">
    </div>

    <div class="form-group">
        <label for="phone">Telefon do restauracji</label>
        <input type="text" id="phone" placeholder="AAAAAAAAA">
    </div>

    <div class="form-group">
        <label for="campaign">Nr. kampanii Weylo</label>
        <input type="text" id="campaign" placeholder="BBBBBBBBB">
    </div>

    <div class="form-group">
        <label for="sim">Nr. karty SIM</label>
        <input type="text" id="sim" placeholder="CCCCCCCCC">
    </div>

    <div class="form-group checkbox-group">
        <input type="checkbox" id="recording" checked>
        <label for="recording">Nagrywanie rozmów (Zaznaczone = NR / Odznaczone = BNR)</label>
    </div>

    <div class="form-group checkbox-group">
        <input type="checkbox" id="esim">
        <label for="esim">E-SIM (dopisuje esim)</label>
    </div>

    <div class="form-group checkbox-group">
        <input type="checkbox" id="queue">
        <label for="queue">Kolejka (dopisuje k)</label>
    </div>

    <!-- Wyjściowy Textbox na żywo -->
    <div class="output-box">
        <label for="output_text">Wygenerowany ciąg znaków:</label>
        <textarea id="output_text" readonly></textarea>
        <div class="hint">Tekst aktualizuje się automatycznie przy wpisywaniu.</div>
    </div>

    <script>
        // Funkcja generująca ciąg znaków w czasie rzeczywistym
        function updateText() {
            // Pobranie wartości z pól
            const clientId = document.getElementById('client_id').value.trim() || 'X';
            const locId = document.getElementById('loc_id').value.trim() || 'Y';
            const phone = document.getElementById('phone').value.trim() || 'AAAAAAAAA';
            const campaign = document.getElementById('campaign').value.trim() || 'BBBBBBBBB';
            const sim = document.getElementById('sim').value.trim() || 'CCCCCCCCC';
            
            // Logika checkboxów
            const isRecording = document.getElementById('recording').checked;
            const recPrefix = isRecording ? "-NR" : "-BNR";
            
            const isEsim = document.getElementById('esim').checked;
            const esimText = isEsim ? " esim" : "";
            
            const isQueue = document.getElementById('queue').checked;
            const queueText = isQueue ? " k" : "";

            // Składanie finalnego ciągu: K`X` L`Y` NR `AAAAAAAAA`-`BBBBBBBBB`-`CCCCCCCCC` g h
            // (Zastosowano spacje przed zmiennymi g i h zgodnie ze wzorem)
            const result = `K${clientId} L${locId}${recPrefix} ${phone}-${campaign}-${sim}${esimText}${queueText}`;
            
            // Wstrzyknięcie tekstu do textarea
            document.getElementById('output_text').value = result;
        }

        // Lista wszystkich ID elementów formularza do nasłuchiwania zmian
        const inputIds = ['client_id', 'loc_id', 'phone', 'campaign', 'sim', 'recording', 'esim', 'queue'];

        // Podpięcie zdarzeń 'input' (dla text) i 'change' (dla checkboxów) pod każdy element
        inputIds.forEach(id => {
            const element = document.getElementById(id);
            element.addEventListener('input', updateText);
            element.addEventListener('change', updateText);
        });

        // Uruchomienie funkcji na starcie, aby pokazać domyślny szablon
        updateText();
    </script>

</body>
</html>
